generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "mysql"
}

model Barbershop {
  id            String        @id @default(uuid())
  name          String?
  phone         String?
  address       String?
  businessHours Json?
  planStatus    String        @default("TRIAL")
  planExpiresAt DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  appointments  Appointment[]
  services      Service[]
  users         User[]
  products      Product[]
  upsellRules   UpsellRule[]

  @@map("barbershops")
}

model User {
  id               String        @id @default(uuid())
  name             String
  email            String        @unique
  password         String
  role             String        @default("OWNER")
  createdAt        DateTime      @default(now())
  barbershopId     String
  resetToken       String?
  resetTokenExpiry DateTime?
  barbershop       Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointments     Appointment[]

  @@index([barbershopId], map: "users_barbershopId_fkey")
  @@map("users")
}

model Appointment {
  id           Int        @id @default(autoincrement())
  clientName   String
  date         String
  time         String
  status       String     @default("CONFIRMED")
  price        Float?     @default(0)
  discount     Float?     @default(0)
  barbershopId String
  barberId     String?
  createdAt    DateTime   @default(now())
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barber       User?      @relation(fields: [barberId], references: [id], onDelete: SetNull)
  services     Service[]  @relation("AppointmentServices")
  products     Product[]  @relation("AppointmentProducts")

  @@index([barbershopId], map: "appointments_barbershopId_fkey")
  @@index([barberId], map: "appointments_barberId_fkey")
  @@map("appointments")
}

model Service {
  id           String        @id @default(uuid())
  name         String
  price        Float
  duration     Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  barbershopId String
  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointments Appointment[] @relation("AppointmentServices")

  @@index([barbershopId], map: "services_barbershopId_fkey")
  @@map("services")
}

model Product {
  id           String        @id @default(uuid())
  name         String
  price        Float
  stock        Int           @default(0)
  barbershopId String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointments Appointment[] @relation("AppointmentProducts")

  @@index([barbershopId], map: "products_barbershopId_fkey")
  @@map("products")
}

model UpsellRule {
  id               String     @id @default(uuid())
  barbershopId     String
  triggerServiceId String
  offerServiceId   String?
  offerProductId   String?
  discountAmount   Float
  discountType     String     @default("PERCENTAGE")
  customCopy       String?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  barbershop       Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  hasDownsell            Boolean @default(false)
  downsellOfferServiceId String?
  downsellOfferProductId String?
  downsellDiscountAmount Float?
  downsellCustomCopy     String?

  @@index([barbershopId], map: "upsellrules_barbershopId_fkey")
  @@map("upsell_rules")
}
